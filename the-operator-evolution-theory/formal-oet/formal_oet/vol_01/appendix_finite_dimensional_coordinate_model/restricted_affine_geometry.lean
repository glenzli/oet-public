section DirectionSpace
variable {E G : Type*} [AddCommGroup E] [Module ℝ E]
  [AddCommGroup G] [Module ℝ G]

/-- Directions generated by actual pairs of points in a set. -/
def direction_span (D : Set E) : Submodule ℝ E :=
  Submodule.span ℝ {v | ∃ x ∈ D, ∃ y ∈ D, v = x - y}

theorem sub_mem_direction_span {D : Set E} {x y : E} (hx : x ∈ D) (hy : y ∈ D) :
    x - y ∈ direction_span D :=
  Submodule.subset_span ⟨x, hx, y, hy, rfl⟩

theorem direction_span_mono {D S : Set E} (h : D ⊆ S) :
    direction_span D ≤ direction_span S := by
  apply Submodule.span_mono
  rintro v ⟨x, hx, y, hy, rfl⟩
  exact ⟨x, h hx, y, h hy, rfl⟩

/-- OET anchor: h-5327d971cf04c4ca
Actual-domain affine direction geometry. -/
theorem direction_span_affine_image (A : E →ₗ[ℝ] G) (b : G) (D : Set E) :
    direction_span ((fun x => A x + b) '' D) = (direction_span D).map A := by
  unfold direction_span
  rw [Submodule.map_span]
  congr 1
  ext v
  constructor
  · rintro ⟨_, ⟨x, hx, rfl⟩, _, ⟨y, hy, rfl⟩, rfl⟩
    refine ⟨x - y, ⟨x, hx, y, hy, rfl⟩, ?_⟩
    simp [map_sub]
  · rintro ⟨_, ⟨x, hx, y, hy, rfl⟩, rfl⟩
    refine ⟨A x + b, ⟨x, hx, rfl⟩, A y + b, ⟨y, hy, rfl⟩, ?_⟩
    simp [map_sub]

theorem linear_domRestrict_direction_span_eq_zero_iff (A : E →ₗ[ℝ] G) (D : Set E) :
    A.domRestrict (direction_span D) = 0 ↔ ∀ x ∈ D, ∀ y ∈ D, A x = A y := by
  constructor
  · intro h x hx y hy
    have hv := LinearMap.congr_fun h ⟨x - y, sub_mem_direction_span hx hy⟩
    have hz : A (x - y) = 0 := hv
    exact sub_eq_zero.mp (by simpa only [map_sub] using hz)
  · intro h
    have hker : direction_span D ≤ LinearMap.ker A := by
      apply Submodule.span_le.mpr
      rintro v ⟨x, hx, y, hy, rfl⟩
      change A (x - y) = 0
      simp [h x hx y hy]
    ext v
    exact hker v.property

theorem affine_constant_iff_restriction_zero (A : E →ₗ[ℝ] G) (b : G) (D : Set E) :
    (∀ x ∈ D, ∀ y ∈ D, A x + b = A y + b) ↔
      A.domRestrict (direction_span D) = 0 := by
  rw [linear_domRestrict_direction_span_eq_zero_iff]
  simp only [add_left_inj]

/-- OET anchor: h-5327d971cf04c4ca
Actual-domain affine direction geometry. -/
theorem affine_linear_eq_on_direction_span (A B : E →ₗ[ℝ] G) (b c : G) (D : Set E)
    (h : ∀ x ∈ D, A x + b = B x + c) :
    A.domRestrict (direction_span D) = B.domRestrict (direction_span D) := by
  have hgen : Set.EqOn A B {v | ∃ x ∈ D, ∃ y ∈ D, v = x - y} := by
    rintro v ⟨x, hx, y, hy, rfl⟩
    have hh := congrArg₂ (fun u v : G => u - v) (h x hx) (h y hy)
    simpa [map_sub] using hh
  ext v
  exact LinearMap.eqOn_span hgen v.property

theorem affine_direction_span_map_eq (A B : E →ₗ[ℝ] G) (b c : G) (D : Set E)
    (h : ∀ x ∈ D, A x + b = B x + c) :
    (direction_span D).map A = (direction_span D).map B := by
  rw [← LinearMap.range_domRestrict, ← LinearMap.range_domRestrict,
    affine_linear_eq_on_direction_span A B b c D h]

/-- OET anchor: h-5327d971cf04c4ca
Actual-domain affine direction geometry. -/
theorem affine_restriction_rank_eq_direction_finrank (A : E →ₗ[ℝ] G) (b : G) (D : Set E) :
    Module.finrank ℝ (LinearMap.range (A.domRestrict (direction_span D))) =
      Module.finrank ℝ (direction_span ((fun x => A x + b) '' D)) := by
  rw [LinearMap.range_domRestrict, direction_span_affine_image]

theorem direction_span_affine_image_finrank_le [Module.Finite ℝ E]
    (A : E →ₗ[ℝ] G) (b : G) (D : Set E) :
    Module.finrank ℝ (direction_span ((fun x => A x + b) '' D)) ≤
      Module.finrank ℝ (direction_span D) := by
  rw [direction_span_affine_image]
  exact Submodule.finrank_map_le A (direction_span D)

end DirectionSpace

section ConvexDomain
variable {E G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [AddCommGroup G] [Module ℝ G]

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem direction_span_eq_top_of_isOpen (D : Set E) (hne : D.Nonempty) (hD : IsOpen D) :
    direction_span D = ⊤ := by
  obtain ⟨y, hy⟩ := hne
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hD y hy
  apply eq_top_iff.mpr
  intro v _
  let t := δ / (2 * (‖v‖ + 1))
  have ht : 0 < t := div_pos hδ (by positivity)
  have heq : t * (‖v‖ + 1) = δ / 2 := by
    dsimp [t]
    field_simp
  have hnorm : ‖t • v‖ < δ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht]
    nlinarith [norm_nonneg v]
  have hx : y + t • v ∈ D := hball (by simpa [Metric.mem_ball, dist_eq_norm] using hnorm)
  have htv : t • v ∈ direction_span D := by
    simpa using sub_mem_direction_span hx hy
  have hv := (direction_span D).smul_mem t⁻¹ htv
  simpa [smul_smul, ht.ne'] using hv

theorem linear_restriction_zero_iff_of_isOpen (A : E →ₗ[ℝ] G) (D : Set E)
    (hne : D.Nonempty) (hD : IsOpen D) :
    A.domRestrict (direction_span D) = 0 ↔ A = 0 := by
  constructor
  · intro h
    ext v
    have hv : v ∈ direction_span D := by rw [direction_span_eq_top_of_isOpen D hne hD]; trivial
    exact LinearMap.congr_fun h ⟨v, hv⟩
  · intro h
    ext v
    simp [h]

/-- In a convex set, a nonconstant linear restriction changes arbitrarily near
every point, including relative boundary points. -/
theorem convex_linear_small_nonfiber (A : E →ₗ[ℝ] G) (D : Set E)
    (hD : Convex ℝ D) (hA : A.domRestrict (direction_span D) ≠ 0)
    (y : E) (hy : y ∈ D) (r : ℝ) (hr : 0 < r) :
    ∃ x ∈ D, ‖x - y‖ < r ∧ A x ≠ A y := by
  have hz : ∃ z ∈ D, A z ≠ A y := by
    by_contra! h
    apply hA
    rw [linear_domRestrict_direction_span_eq_zero_iff]
    intro x hx z hz
    exact (h x hx).trans (h z hz).symm
  obtain ⟨z, hz, hne⟩ := hz
  let t := min 1 (r / (2 * (‖z - y‖ + 1)))
  have ht : 0 < t := lt_min zero_lt_one (div_pos hr (by positivity))
  have ht_one : t ≤ 1 := min_le_left _ _
  have ht_bound : t ≤ r / (2 * (‖z - y‖ + 1)) := min_le_right _ _
  have heq : (r / (2 * (‖z - y‖ + 1))) * (‖z - y‖ + 1) = r / 2 := by
    field_simp
  have hnorm : ‖t • (z - y)‖ < r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht]
    have hh := mul_le_mul_of_nonneg_right ht_bound (by positivity : 0 ≤ ‖z - y‖ + 1)
    rw [heq] at hh
    nlinarith [norm_nonneg (z - y)]
  refine ⟨y + t • (z - y), hD.add_smul_sub_mem hy hz ⟨ht.le, ht_one⟩,
    by simpa using hnorm, ?_⟩
  intro he
  have hh : t • (A z - A y) = 0 := by
    simpa only [map_add, map_smul, map_sub, add_eq_left] using he
  exact hne (sub_eq_zero.mp ((smul_eq_zero.mp hh).resolve_left ht.ne'))

end ConvexDomain

variable {n : ℕ} [NeZero n]

omit [NeZero n] in
/-- OET anchor: h-5327d971cf04c4ca
Actual-domain affine direction geometry. -/
theorem affine_row_constant_iff (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n)
    (b : CoordinateVector n) (D : Set (CoordinateVector n)) (j : Fin n) :
    (∀ x ∈ D, ∀ y ∈ D, coordinate_affine_map A b x j = coordinate_affine_map A b y j) ↔
      (coordinate_linear_row A j).domRestrict (direction_span D) = 0 := by
  exact affine_constant_iff_restriction_zero (coordinate_linear_row A j) (b j) D

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem affine_coordinate_radius_on_convex_set
    (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n) (b : CoordinateVector n)
    (D : Set (CoordinateVector n)) (hD : Convex ℝ D)
    (y : CoordinateVector n) (hy : y ∈ D) (i j : Fin n) :
    coordinate_model_radius (coordinate_affine_map A b) D i j y =
      if (coordinate_linear_row A j).domRestrict (direction_span D) = 0 then ⊤ else 0 := by
  rw [coordinate_model_radius_eq _ _ _ _ _ hy]
  split_ifs with hA
  · apply exact_constancy_radius_eq_top_of_constant
    intro x hx
    exact (affine_row_constant_iff A b D j).mpr hA x hx y hy
  · apply exact_constancy_radius_eq_zero_of_close_nonfiber
    intro r hr
    obtain ⟨x, hx, hnorm, hne⟩ := convex_linear_small_nonfiber
      (coordinate_linear_row A j) D hD hA y hy r.toReal
      (ENNReal.toReal_pos hr.1.ne' hr.2)
    refine ⟨x, hx, ?_, ?_⟩
    · apply (ENNReal.ofReal_lt_iff_lt_toReal (abs_nonneg _) hr.2).mpr
      exact (norm_le_pi_norm (x - y) i).trans_lt hnorm
    · exact fun h => hne (add_right_cancel h)

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem affine_full_radius_on_convex_set
    (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n) (b : CoordinateVector n)
    (D : Set (CoordinateVector n)) (hD : Convex ℝ D)
    (y : CoordinateVector n) (hy : y ∈ D) :
    full_model_radius (coordinate_affine_map A b) D y =
      if A.domRestrict (direction_span D) = 0 then ⊤ else 0 := by
  rw [full_model_radius_eq _ _ _ hy]
  split_ifs with hA
  · apply exact_constancy_radius_eq_top_of_constant
    intro x hx
    exact (affine_constant_iff_restriction_zero A b D).mpr hA x hx y hy
  · apply exact_constancy_radius_eq_zero_of_close_nonfiber
    intro r hr
    obtain ⟨x, hx, hnorm, hne⟩ := convex_linear_small_nonfiber A D hD hA y hy r.toReal
      (ENNReal.toReal_pos hr.1.ne' hr.2)
    refine ⟨x, hx, ?_, ?_⟩
    · rw [coordinate_sup_distance_eq_norm]
      exact (ENNReal.ofReal_lt_iff_lt_toReal (norm_nonneg _) hr.2).mpr hnorm
    · exact fun h => hne (add_right_cancel h)

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem affine_coordinate_radius_on_convex_or_open_set
    (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n) (b : CoordinateVector n)
    (D : Set (CoordinateVector n)) (hD : Convex ℝ D ∨ IsOpen D)
    (y : CoordinateVector n) (hy : y ∈ D) (i j : Fin n) :
    coordinate_model_radius (coordinate_affine_map A b) D i j y =
      if (coordinate_linear_row A j).domRestrict (direction_span D) = 0 then ⊤ else 0 := by
  rcases hD with hD | hD
  · exact affine_coordinate_radius_on_convex_set A b D hD y hy i j
  · rw [affine_coordinate_radius_on_open_set A b D hD y hy i j,
      linear_restriction_zero_iff_of_isOpen (coordinate_linear_row A j) D ⟨y, hy⟩ hD]

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem affine_full_radius_on_convex_or_open_set
    (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n) (b : CoordinateVector n)
    (D : Set (CoordinateVector n)) (hD : Convex ℝ D ∨ IsOpen D)
    (y : CoordinateVector n) (hy : y ∈ D) :
    full_model_radius (coordinate_affine_map A b) D y =
      if A.domRestrict (direction_span D) = 0 then ⊤ else 0 := by
  rcases hD with hD | hD
  · exact affine_full_radius_on_convex_set A b D hD y hy
  · rw [affine_full_model_radius_on_open_set A b D hD y hy,
      linear_restriction_zero_iff_of_isOpen A D ⟨y, hy⟩ hD]

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem affine_min_radius_on_convex_or_open_set
    (φ : Operator (CoordinatePoint n Set.univ) none)
    (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n) (b : CoordinateVector n)
    (D : Set (CoordinateVector n)) (hne : D.Nonempty) (hD : Convex ℝ D ∨ IsOpen D)
    (hF : ∀ x ∈ D, φ.func (full_coordinate_point x) = full_coordinate_point (coordinate_affine_map A b x))
    (i j : Fin n) :
    min_annihilation_radius coordinate_dist φ i (singleton_nonempty_finset j)
      (coordinate_model_set Set.univ D) =
      if (coordinate_linear_row A j).domRestrict (direction_span D) = 0 then ⊤ else 0 := by
  have he : LocalEquivalent φ (full_model_operator (coordinate_affine_map A b) D)
      (coordinate_model_set Set.univ D) := by
    rintro z ⟨a, ha, rfl⟩
    simpa [full_coordinate_point, full_model_operator, coordinate_model_operator, ha] using hF a.val ha
  have hr (y : CoordinateVector n) (hy : y ∈ D) :
      annihilation_radius coordinate_dist φ i (singleton_nonempty_finset j)
        (coordinate_model_set Set.univ D) (full_coordinate_point y) =
        if (coordinate_linear_row A j).domRestrict (direction_span D) = 0 then ⊤ else 0 := by
    rw [local_equiv_annihilation_radius_eq coordinate_dist φ _ _ i _ _
      (by exact ⟨⟨y, Set.mem_univ y⟩, hy, rfl⟩) he]
    exact affine_coordinate_radius_on_convex_or_open_set A b D hD y hy i j
  unfold min_annihilation_radius
  apply le_antisymm
  · obtain ⟨y, hy⟩ := hne
    exact (iInf₂_le (full_coordinate_point y) ⟨⟨y, Set.mem_univ y⟩, hy, rfl⟩).trans (hr y hy).le
  · apply le_iInf
    intro y
    apply le_iInf
    rintro ⟨a, ha, rfl⟩
    exact (hr a.val ha).ge

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem affine_full_min_radius_on_convex_or_open_set
    (φ : Operator (CoordinatePoint n Set.univ) none)
    (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n) (b : CoordinateVector n)
    (D : Set (CoordinateVector n)) (hne : D.Nonempty) (hD : Convex ℝ D ∨ IsOpen D)
    (hF : ∀ x ∈ D, φ.func (full_coordinate_point x) = full_coordinate_point (coordinate_affine_map A b x)) :
    metric_min_annihilation_radius coordinate_full_dist coordinate_full_dist φ
      (coordinate_model_set Set.univ D) =
      if A.domRestrict (direction_span D) = 0 then ⊤ else 0 := by
  have he : LocalEquivalent φ (full_model_operator (coordinate_affine_map A b) D)
      (coordinate_model_set Set.univ D) := by
    rintro z ⟨a, ha, rfl⟩
    simpa [full_coordinate_point, full_model_operator, coordinate_model_operator, ha] using hF a.val ha
  have hr (y : CoordinateVector n) (hy : y ∈ D) :
      metric_annihilation_radius coordinate_full_dist coordinate_full_dist φ
        (coordinate_model_set Set.univ D) (full_coordinate_point y) =
        if A.domRestrict (direction_span D) = 0 then ⊤ else 0 := by
    have hyS : full_coordinate_point y ∈ coordinate_model_set Set.univ D :=
      ⟨⟨y, Set.mem_univ y⟩, hy, rfl⟩
    calc
      _ = full_model_radius (coordinate_affine_map A b) D y := by
        change metric_annihilation_radius coordinate_full_dist coordinate_full_dist φ
          (coordinate_model_set Set.univ D) (full_coordinate_point y) =
          metric_annihilation_radius coordinate_full_dist coordinate_full_dist
          (full_model_operator (coordinate_affine_map A b) D)
          (coordinate_model_set Set.univ D) (full_coordinate_point y)
        unfold metric_annihilation_radius
        apply iSup_congr
        intro r
        apply iSup_congr
        intro hr
        apply iSup_congr_Prop ?_ (by intros; rfl)
        constructor
        · intro h x hx
          have hh := h hx
          refine ⟨hh.1, ?_⟩
          rw [← he x hx.2, ← he _ hyS]
          exact hh.2
        · intro h x hx
          have hh := h hx
          refine ⟨hh.1, ?_⟩
          rw [he x hx.2, he _ hyS]
          exact hh.2
      _ = _ := affine_full_radius_on_convex_or_open_set A b D hD y hy
  unfold metric_min_annihilation_radius metric_min_annihilation_radius_on
  apply le_antisymm
  · obtain ⟨y, hy⟩ := hne
    exact (iInf₂_le (full_coordinate_point y) ⟨⟨y, Set.mem_univ y⟩, hy, rfl⟩).trans (hr y hy).le
  · apply le_iInf
    intro y
    apply le_iInf
    rintro ⟨a, ha, rfl⟩
    exact (hr a.val ha).ge

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem affine_min_radius_on_convex_set
    (φ : Operator (CoordinatePoint n Set.univ) none)
    (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n) (b : CoordinateVector n)
    (D : Set (CoordinateVector n)) (hne : D.Nonempty) (hD : Convex ℝ D)
    (hF : ∀ x ∈ D, φ.func (full_coordinate_point x) = full_coordinate_point (coordinate_affine_map A b x))
    (i j : Fin n) :
    min_annihilation_radius coordinate_dist φ i (singleton_nonempty_finset j)
      (coordinate_model_set Set.univ D) =
      if (coordinate_linear_row A j).domRestrict (direction_span D) = 0 then ⊤ else 0 :=
  affine_min_radius_on_convex_or_open_set φ A b D hne (Or.inl hD) hF i j

/-- OET anchor: h-055e3702cf9c3930
Restricted affine zero-radius classification, including lower-dimensional convex domains. -/
theorem affine_full_min_radius_on_convex_set
    (φ : Operator (CoordinatePoint n Set.univ) none)
    (A : CoordinateVector n →ₗ[ℝ] CoordinateVector n) (b : CoordinateVector n)
    (D : Set (CoordinateVector n)) (hne : D.Nonempty) (hD : Convex ℝ D)
    (hF : ∀ x ∈ D, φ.func (full_coordinate_point x) = full_coordinate_point (coordinate_affine_map A b x)) :
    metric_min_annihilation_radius coordinate_full_dist coordinate_full_dist φ
      (coordinate_model_set Set.univ D) =
