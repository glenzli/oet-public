import formal_oet.vol_01.appendix_finite_dimensional_coordinate_model.norm_ball_bridge
import Mathlib.Topology.EMetricSpace.Basic
import Mathlib.Topology.UniformSpace.CompleteSeparated
import Mathlib.Analysis.Normed.Module.FiniteDimension

namespace formal_oet.vol_01.appendix_finite_dimensional_coordinate_model
open formal_oet.vol_01.ch_01_foundations
open formal_oet.vol_01.appendix_separating_gauge_specialization
open Filter Topology
noncomputable section

@[reducible] def extended_metric_space {X : Type} {bot : X} {d : X → X → ENNReal}
    (h : ExtendedPseudoMetric X bot d) : PseudoEMetricSpace X where
  edist := d
  edist_self := h.dist_self
  edist_comm := h.symm
  edist_triangle := h.triangle

theorem distance_topology_le_of_cofinal {X : Type} (m₁ m₂ : PseudoEMetricSpace X)
    (h : ∀ ε : ENNReal, 0 < ε → ∃ δ : ENNReal, 0 < δ ∧
      ∀ x y, m₁.edist x y < δ → m₂.edist x y < ε) :
    m₁.toUniformSpace.toTopologicalSpace ≤ m₂.toUniformSpace.toTopologicalSpace := by
  intro U hU
  apply (@EMetric.isOpen_iff X m₁ U).mpr
  intro x hx
  obtain ⟨ε, hε, hball⟩ := (@EMetric.isOpen_iff X m₂ U).mp hU x hx
  obtain ⟨δ, hδ, hδball⟩ := h ε hε
  exact ⟨δ, hδ, fun y hy => hball (hδball y x hy)⟩

variable {n : ℕ} [NeZero n] {A : Set (CoordinateVector n)}

@[reducible] def coordinate_component_space (hA : A.Nonempty) (i : Fin n) : PseudoEMetricSpace (CoordinatePoint n A) :=
  extended_metric_space (coordinate_dist_is_extended_pseudo_metric hA i)

@[reducible] def coordinate_full_space (hA : A.Nonempty) : PseudoEMetricSpace (CoordinatePoint n A) :=
  extended_metric_space (full_gauge_extended_pseudo_metric
    (fun i : Fin n => coordinate_dist i) (coordinate_dist_is_extended_pseudo_metric hA))

/-- The initial topology of the original coordinate pseudometrics: equivalently,
the topology generated by all their open balls and finite intersections. -/
@[reducible] def coordinate_gauge_topology (hA : A.Nonempty) : TopologicalSpace (CoordinatePoint n A) :=
  ⨅ i : Fin n, (coordinate_component_space hA i).toUniformSpace.toTopologicalSpace

theorem coordinate_gauge_topology_eq_full (hA : A.Nonempty) :
    coordinate_gauge_topology hA = (coordinate_full_space hA).toUniformSpace.toTopologicalSpace := by
  apply le_antisymm
  · intro U hU
    letI := coordinate_gauge_topology hA
    apply isOpen_iff_mem_nhds.mpr
    intro x hx
    obtain ⟨ε, hε, hball⟩ := (@EMetric.isOpen_iff _ (coordinate_full_space hA) U).mp hU x hx
    have he : @Metric.eball _ (coordinate_full_space hA) x ε =
        ⋂ i : Fin n, @Metric.eball _ (coordinate_component_space hA i) x ε := by
      ext y
      change (Finset.univ.sup (fun i => coordinate_dist i y x) < ε) ↔ _
      simp only [Finset.sup_lt_iff hε, Set.mem_iInter, Finset.mem_univ, forall_true_left]
      rfl
    have hopen : IsOpen (@Metric.eball _ (coordinate_full_space hA) x ε) := by
      rw [he]
      apply isOpen_iInter_of_finite
      intro i
      exact (iInf_le (fun i : Fin n => (coordinate_component_space hA i).toUniformSpace.toTopologicalSpace) i)
        _ (@Metric.isOpen_eball _ (coordinate_component_space hA i) x ε)
    apply Filter.mem_of_superset (hopen.mem_nhds ?_) hball
    change (coordinate_full_space hA).edist x x < ε
    rw [(coordinate_full_space hA).edist_self]
    exact hε
  · apply le_iInf
    intro i
    apply distance_topology_le_of_cofinal
    intro ε hε
    refine ⟨ε, hε, ?_⟩
    intro x y hxy
    exact (Finset.le_sup (f := fun i : Fin n => coordinate_dist i x y) (Finset.mem_univ i)).trans_lt hxy

@[reducible] def coordinate_norm_space (p : Seminorm ℝ (CoordinateVector n)) :
    PseudoEMetricSpace (CoordinatePoint n A) where
  edist := coordinate_norm_distance p
  edist_self x := by cases x <;> simp [coordinate_norm_distance]
  edist_comm x y := by
    cases x <;> cases y <;> simp [coordinate_norm_distance, map_sub_rev]
  edist_triangle x y z := by
    cases x with
    | none => cases y <;> cases z <;> simp [coordinate_norm_distance]
    | some x =>
      cases y with
      | none => cases z <;> simp [coordinate_norm_distance]
      | some y =>
        cases z with
        | none => simp [coordinate_norm_distance]
        | some z =>
          change ENNReal.ofReal (p (x.val - z.val)) ≤
            ENNReal.ofReal (p (x.val - y.val)) + ENNReal.ofReal (p (y.val - z.val))
          rw [← ENNReal.ofReal_add (apply_nonneg p _) (apply_nonneg p _)]
          apply ENNReal.ofReal_le_ofReal
          calc
            p (x.val - z.val) = p ((x.val - y.val) + (y.val - z.val)) := by rw [sub_add_sub_cancel]
            _ ≤ _ := map_add_le_add p _ _

/--
OET anchor: h-5cd365cd756cb93e
All three actual topologies on the absorbing-point coordinate model coincide.
-/
theorem coordinate_and_actual_norm_topologies (hA : A.Nonempty)
    (p : Seminorm ℝ (CoordinateVector n)) (a b : ℝ) (ha : 0 < a) (hb : 0 < b)
    (hlower : ∀ v, a * ‖v‖ ≤ p v) (hupper : ∀ v, p v ≤ b * ‖v‖) :
    coordinate_gauge_topology hA = (coordinate_full_space hA).toUniformSpace.toTopologicalSpace ∧
    (coordinate_full_space hA).toUniformSpace.toTopologicalSpace =
      (coordinate_norm_space (A := A) p).toUniformSpace.toTopologicalSpace := by
  refine ⟨coordinate_gauge_topology_eq_full hA, le_antisymm ?_ ?_⟩
  · apply distance_topology_le_of_cofinal
    intro ε hε
    obtain ⟨r, hr, hrε⟩ := ENNReal.lt_iff_exists_nnreal_btwn.mp hε
    have hrreal : 0 < (r : ℝ) := by exact_mod_cast hr
    refine ⟨ENNReal.ofReal ((r : ℝ) / b), ENNReal.ofReal_pos.mpr (div_pos hrreal hb), ?_⟩
    intro x y hxy
    have h := (norm_ball_comparison_of_norm_bounds p a b r ha hb hrreal hlower hupper).full_small_to_star x y hxy
    exact h.trans_le (by simpa using hrε.le)
  · apply distance_topology_le_of_cofinal
    intro ε hε
    obtain ⟨r, hr, hrε⟩ := ENNReal.lt_iff_exists_nnreal_btwn.mp hε
    have hrreal : 0 < (r : ℝ) := by exact_mod_cast hr
    refine ⟨ENNReal.ofReal (a * (r : ℝ)), ENNReal.ofReal_pos.mpr (mul_pos ha hrreal), ?_⟩
    intro x y hxy
    have h := (norm_ball_comparison_of_norm_bounds p a b (a * r) ha hb (mul_pos ha hrreal)
      hlower hupper).star_to_full_large x y hxy
    have he : a * (r : ℝ) / a = r := mul_div_cancel_left₀ _ ha.ne'
    rw [he] at h
    exact h.trans_le (by simpa using hrε.le)

/-- The uniform structure really used by the selected seminorm distance. -/
@[reducible] def seminorm_uniformity (p : Seminorm ℝ (CoordinateVector n)) : UniformSpace (CoordinateVector n) :=
  p.toAddGroupSeminorm.toSeminormedAddCommGroup.toUniformSpace

/-- The added absorbing point is isolated in the actual extended norm model. -/
theorem absorbing_point_isolated (p : Seminorm ℝ (CoordinateVector n)) :
    @IsOpen _ (coordinate_norm_space (A := A) p).toUniformSpace.toTopologicalSpace
      {none} := by
  have hball : @Metric.eball _ (coordinate_norm_space (A := A) p) none 1 = {none} := by
    ext x
    change coordinate_norm_distance p x none < 1 ↔ x ∈ ({none} : Set _)
    cases x <;> simp [coordinate_norm_distance]
  rw [← hball]
  exact @Metric.isOpen_eball _ (coordinate_norm_space (A := A) p) none 1

theorem actual_seminorm_uniformity_eq (p : Seminorm ℝ (CoordinateVector n))
    (a b : ℝ) (ha : 0 < a) (hb : 0 < b)
    (hlower : ∀ v, a * ‖v‖ ≤ p v) (hupper : ∀ v, p v ≤ b * ‖v‖) :
    (inferInstance : UniformSpace (CoordinateVector n)) = seminorm_uniformity p := by
  apply p.uniformSpace_eq_of_hasBasis (Metric.nhds_basis_ball (x := (0 : CoordinateVector n)))
  · refine ⟨b, Filter.mem_of_superset (Metric.ball_mem_nhds 0 zero_lt_one) ?_⟩
    intro v hv
    change p (v - 0) ≤ b
    have hv' : ‖v‖ < 1 := by simpa [Metric.mem_ball, dist_eq_norm] using hv
    simpa using (hupper v).trans (by nlinarith)
  · intro ε hε
    refine ⟨a * ε, mul_pos ha hε, ?_⟩
    intro v hv
    change p (v - 0) < a * ε at hv
    have hv' : ‖v‖ < ε := by
      rw [sub_zero] at hv
      nlinarith [hlower v]
    simpa only [Metric.mem_ball, dist_eq_norm, sub_zero] using hv'

/--
OET anchor: h-5cd365cd756cb93e
Completeness is proved for the chosen norm's actual uniform structure, and
compactness for its actual topology. Closedness and boundedness refer to R^n.
-/
theorem actual_norm_complete_compact_criteria (p : Seminorm ℝ (CoordinateVector n))
    (a b : ℝ) (ha : 0 < a) (hb : 0 < b)
    (hlower : ∀ v, a * ‖v‖ ≤ p v) (hupper : ∀ v, p v ≤ b * ‖v‖)
    (S : Set (CoordinateVector n)) :
    (@IsComplete _ (seminorm_uniformity p) S ↔ IsClosed S) ∧
    (@IsCompact _ (seminorm_uniformity p).toTopologicalSpace S ↔
      IsClosed S ∧ Bornology.IsBounded S) := by
  rw [← actual_seminorm_uniformity_eq p a b ha hb hlower hupper]
  exact ⟨⟨fun h => h.isClosed, fun h => h.isComplete⟩, Metric.isCompact_iff_isClosed_bounded⟩

end
