theorem path_with_fuel_nodup :
    ∀ (n : Nat) (β : V) (y : X),
      y ∈ N.node_dom β →
        (N.path_with_fuel n β y).Nodup := by
  intro n
  induction n with
  | zero =>
      intro β y _
      simp [path_with_fuel, path_with_fuel_core]
  | succ n ih =>
      intro β y hy
      unfold path_with_fuel path_with_fuel_core
      cases hchoice : N.choice β ((N.node_op β).func y) with
      | stop =>
          simp
      | next γ =>
          have hyγ : (N.node_op β).func y ∈ N.node_dom γ :=
            N.choice_next_mem hy hchoice
          have hrest :
              (path_with_fuel_core N.node_op N.choice n γ
                ((N.node_op β).func y)).Nodup := by
            simpa [path_with_fuel] using
              ih γ ((N.node_op β).func y) hyγ
          have hnot :
              β ∉ path_with_fuel_core N.node_op N.choice n γ
                ((N.node_op β).func y) := by
            intro hβ
            have hmem : β ∈ N.path_with_fuel n γ ((N.node_op β).func y) := by
              simpa [path_with_fuel] using hβ
            have hle : N.rank β ≤ N.rank γ :=
              N.mem_path_with_fuel_rank_le n γ ((N.node_op β).func y) β hyγ hmem
            have hlt : N.rank γ < N.rank β :=
              N.choice_next_rank hy hchoice
            exact (Nat.lt_irrefl (N.rank β)) (lt_of_le_of_lt hle hlt)
          simp [hnot, hrest]

