noncomputable instance prefix_occurrence_fintype : Fintype N.PrefixOccurrence := by
  classical
  letI : Fintype V := N.node_fintype
  let S : Finset (List V) := Finset.univ.biUnion
    (fun p : N.ReachablePath => p.nodes.inits.toFinset)
  let code : N.PrefixOccurrence → {q // q ∈ S} := fun q => ⟨q.nodes, by
