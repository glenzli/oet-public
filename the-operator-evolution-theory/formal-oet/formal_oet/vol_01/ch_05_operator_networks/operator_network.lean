theorem disjoint_path_domain_of_ne {p q : List V} (hne : p ≠ q) :
    Disjoint (N.path_domain p) (N.path_domain q) := by
  rw [Set.disjoint_iff]
  intro x hx
  rcases hx.1 with ⟨hUp, hp⟩
  rcases hx.2 with ⟨hUq, hq⟩
  have hsub : (⟨x, hUp⟩ : {x : X // x ∈ N.U}) = ⟨x, hUq⟩ := by
    apply Subtype.ext
    rfl
  have hpath_eq :
      N.path_of ⟨x, hUp⟩ = N.path_of ⟨x, hUq⟩ := by
    rw [hsub]
  exact hne (hp.symm.trans (hpath_eq.trans hq))

/--
OET anchor: h-f4f084a4606187ed
**定义（网络表示）**
网络 `N` 表示算子 `φ` 在 `U` 上的限制，当且仅当 `U` 非空且二者在 `U` 上局部等价。
