    apply Finset.mem_biUnion.mpr
    refine ⟨p, Finset.mem_univ _, ?_⟩
    apply List.mem_toFinset.mpr
    exact (List.mem_inits _ _).mpr ⟨rest, hp.symm⟩⟩
  exact Fintype.ofInjective code (by
    intro q r h
    have hnodes : q.nodes = r.nodes := congrArg Subtype.val h
    cases q
    cases r
    cases hnodes
    rfl)

