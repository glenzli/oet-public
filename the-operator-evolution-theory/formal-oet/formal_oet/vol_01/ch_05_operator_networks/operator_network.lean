OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，编码）**
可达路径可注入到长度不超过节点数的有限向量族中。
-/
noncomputable def reachable_path_code (p : N.ReachablePath) :
    Fin (N.node_count + 1) × (Fin N.node_count → Option V) :=
  (⟨p.nodes.length,
      Nat.lt_succ_of_le (N.reachable_path_nodes_length_le_node_count p)⟩,
    fun i =>
      if hi : i.val < p.nodes.length then
        some (p.nodes.get ⟨i.val, hi⟩)
      else
        none)

/--
OET anchor: h-56edb9917107efcd **命题 #h-56edb9917107efcd（路径分解与可达路径有限性，有限性）** 可达路径编码是单射。 -/
theorem reachable_path_code_injective :
    Function.Injective N.reachable_path_code := by
  intro p q hpq
  cases p with
  | mk pnodes pnonempty =>
      cases q with
      | mk qnodes qnonempty =>
          have hp_len :
              pnodes.length ≤ N.node_count :=
            N.reachable_path_nodes_length_le_node_count
              ⟨pnodes, pnonempty⟩
          have hq_len :
              qnodes.length ≤ N.node_count :=
            N.reachable_path_nodes_length_le_node_count
              ⟨qnodes, qnonempty⟩
          have hlen : pnodes.length = qnodes.length := by
            exact Fin.ext_iff.mp (congrArg Prod.fst hpq)
          have hget :
              ∀ (n : Nat) (hp : n < pnodes.length) (hq : n < qnodes.length),
                pnodes.get ⟨n, hp⟩ = qnodes.get ⟨n, hq⟩ := by
            intro n hp hq
            have hn : n < N.node_count := lt_of_lt_of_le hp hp_len
            have hfun :=
              congrFun (congrArg Prod.snd hpq) ⟨n, hn⟩
            dsimp [reachable_path_code] at hfun
            simp only [hp, hq, ↓reduceDIte] at hfun
            exact Option.some.inj hfun
          have hnodes : pnodes = qnodes := by
            exact List.ext_get hlen hget
          cases hnodes
          rfl

noncomputable instance reachable_path_fintype : Fintype N.ReachablePath := by
  letI : Fintype V := N.node_fintype
  exact Fintype.ofInjective N.reachable_path_code
    N.reachable_path_code_injective

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（路径域）** 每个路径域都包含于 `U`。 -/
theorem path_domain_subset_source {p : List V} :
    N.path_domain p ⊆ N.U := by
  intro x hx
  exact hx.1

/--
OET anchor: h-56edb9917107efcd **命题 #h-56edb9917107efcd（路径分解与可达路径有限性，覆盖）** 可达路径域覆盖 `U`。 -/
theorem reachable_path_domains_cover :
    (⋃ p : N.ReachablePath, N.path_domain p.nodes) = N.U := by
  ext x
  constructor
  · intro hx
    rcases Set.mem_iUnion.mp hx with ⟨p, hxp⟩
    exact N.path_domain_subset_source hxp
  · intro hx
    let nodes := N.path_of ⟨x, hx⟩
    let p : N.ReachablePath := ⟨nodes, ⟨x, hx, rfl⟩⟩
    exact Set.mem_iUnion.mpr ⟨p, hx, rfl⟩

/--
OET anchor: h-56edb9917107efcd **命题 #h-56edb9917107efcd（路径分解与可达路径有限性，互斥）** 不同路径域互不相交。 -/
theorem disjoint_path_domain_of_ne {p q : List V} (hne : p ≠ q) :
    Disjoint (N.path_domain p) (N.path_domain q) := by
  rw [Set.disjoint_iff]
  intro x hx
  rcases hx.1 with ⟨hUp, hp⟩
  rcases hx.2 with ⟨hUq, hq⟩
  have hsub : (⟨x, hUp⟩ : {x : X // x ∈ N.U}) = ⟨x, hUq⟩ := by
    apply Subtype.ext
    rfl
  have hpath_eq :
      N.path_of ⟨x, hUp⟩ = N.path_of ⟨x, hUq⟩ := by
    rw [hsub]
  exact hne (hp.symm.trans (hpath_eq.trans hq))

/--
OET anchor: h-f4f084a4606187ed
**定义（网络表示）**
网络 `N` 表示算子 `φ` 在 `U` 上的限制，当且仅当 `U` 非空且二者在 `U` 上局部等价。
-/
def represents (φ : Operator X bot) : Prop :=
  N.U.Nonempty ∧ LocalEquivalent N.extensional_operator φ N.U

/--
OET anchor: h-012f4ba72aeb3f20 **命题 #h-012f4ba72aeb3f20（加细保持等价，抽象接口）** 局部等价关系可传递。 -/
theorem represents_of_local_equivalent {φ ψ : Operator X bot}
    (hNφ : N.represents φ) (hφψ : LocalEquivalent φ ψ N.U) :
    N.represents ψ := by
  refine ⟨hNφ.1, ?_⟩
  intro x hx
  exact (hNφ.2 x hx).trans (hφψ x hx)

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（前缀关系）**
`q` 是 `p` 的路径前缀，当且仅当存在后缀 `r` 使 `p = q ++ r`。
-/
def is_prefix (q p : List V) : Prop :=
  ∃ r : List V, p = q ++ r

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（前缀域）**
初始输入路径以 `q` 开头的输入集合；当 `q` 为非空可达前缀时，对应 `U[q*]`。
-/
def prefix_domain (q : List V) : Set X :=
  {x | ∃ hx : x ∈ N.U, is_prefix q (N.path_of ⟨x, hx⟩)}

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（前缀当前输入域）** 前缀发生处的当前输入点集合。 -/
def prefix_input_domain (q : List V) : Set X :=
  N.chain_eval_nodes q.dropLast '' N.prefix_domain q

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（前缀当前输出域）** 前缀发生处的当前输出点集合。 -/
def prefix_output_domain (q : List V) : Set X :=
  N.chain_eval_nodes q '' N.prefix_domain q

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（可达前缀发生）** 可达路径的非空前缀。 -/
structure PrefixOccurrence where
  nodes : List V
  nonempty_nodes : nodes ≠ []
  reachable : ∃ p : N.ReachablePath, is_prefix nodes p.nodes

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（前缀发生非空性）** 可达前缀发生的前缀域非空。 -/
theorem prefix_domain_nonempty (q : N.PrefixOccurrence) :
    (N.prefix_domain q.nodes).Nonempty := by
  rcases q.reachable with ⟨p, hpref⟩
  rcases p.nonempty_domain with ⟨x, hxp⟩
  rcases hxp with ⟨hxU, hxpath⟩
  refine ⟨x, hxU, ?_⟩
  simpa [hxpath] using hpref

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（当前输入域非空性）** 可达前缀发生的当前输入域非空。 -/
theorem prefix_input_domain_nonempty (q : N.PrefixOccurrence) :
    (N.prefix_input_domain q.nodes).Nonempty := by
  rcases N.prefix_domain_nonempty q with ⟨x, hx⟩
  exact ⟨N.chain_eval_nodes q.nodes.dropLast x, Set.mem_image_of_mem _ hx⟩

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（当前输出域非空性）** 可达前缀发生的当前输出域非空。 -/
theorem prefix_output_domain_nonempty (q : N.PrefixOccurrence) :
    (N.prefix_output_domain q.nodes).Nonempty := by
  rcases N.prefix_domain_nonempty q with ⟨x, hx⟩
  exact ⟨N.chain_eval_nodes q.nodes x, Set.mem_image_of_mem _ hx⟩

/--
OET anchor: h-86752cb60c8e01e3
**定义（无环网络作为有限网络）**
Every acyclic network is a finite network, with the uniform depth bounded by
the node count.
-/
noncomputable def to_finite : FiniteOperatorNetwork X bot V where
  U := N.U
  bot_not_mem := N.bot_not_mem
  node_fintype := N.node_fintype
  node_op := N.node_op
  node_dom_nonempty := N.node_dom_nonempty
  entry := N.entry
  entry_mem := N.entry_mem
  choice := N.choice
  choice_next_mem := N.choice_next_mem
  depth_bound := N.node_count
  path_of := N.path_of
  path_terminal := N.path_terminal
  path_length_le_depth := by
    intro x
    exact N.path_of_length_le_node_count x
  node_reachable := by
    intro β
    exact N.node_mem_some_path β

/--
OET anchor: h-86752cb60c8e01e3
**定义（无环网络作为有限网络）**
Viewing an acyclic network as a finite network preserves its extensional
operator.
