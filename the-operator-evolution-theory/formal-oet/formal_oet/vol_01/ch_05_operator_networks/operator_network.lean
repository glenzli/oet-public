OET anchor: h-86752cb60c8e01e3 **定义（初始选择片）** 入口函数诱导的入口分块。 -/
def entry_domain (β : V) : Set X :=
  {x | ∃ hx : x ∈ N.U, N.entry ⟨x, hx⟩ = β}

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（入口分划覆盖）** 入口域覆盖 `U`。 -/
theorem entry_domain_cover : (⋃ β : V, N.entry_domain β) = N.U := by
  ext x
  constructor
  · intro hx
    rcases Set.mem_iUnion.mp hx with ⟨β, hxβ⟩
    exact hxβ.1
  · intro hx
    exact Set.mem_iUnion.mpr ⟨N.entry ⟨x, hx⟩, hx, rfl⟩

/--
OET anchor: h-374f884cd4d69e88 **§ #h-374f884cd4d69e88（入口分划互斥）** 不同入口域互不相交。 -/
theorem disjoint_entry_domain_of_ne {β γ : V} (hne : β ≠ γ) :
    Disjoint (N.entry_domain β) (N.entry_domain γ) := by
  rw [Set.disjoint_iff]
  intro x hx
  rcases hx.1 with ⟨hUβ, hβ⟩
  rcases hx.2 with ⟨hUγ, hγ⟩
  have hsub : (⟨x, hUβ⟩ : {x : X // x ∈ N.U}) = ⟨x, hUγ⟩ := by
    apply Subtype.ext
    rfl
  have hentry_eq :
      N.entry ⟨x, hUβ⟩ = N.entry ⟨x, hUγ⟩ := by
    rw [hsub]
  exact hne (hβ.symm.trans (hentry_eq.trans hγ))

