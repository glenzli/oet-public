noncomputable def extensional_operator : Operator X bot :=
  by
    classical
    refine
      ⟨fun x => if hx : x ∈ N.U then N.eval ⟨x, hx⟩ else bot, ?_⟩
    simp [N.bot_not_mem]

/--
OET anchor: h-13bcaf7893e917fe **引理 #h-13bcaf7893e917fe（定义域）** 外延算子的定义域正好是网络输入域 `U`。 -/
theorem dom_extensional_operator_eq : dom N.extensional_operator = N.U := by
  classical
  ext x
  constructor
  · intro hxdom
    by_cases hx : x ∈ N.U
    · exact hx
    · dsimp [dom, extensional_operator] at hxdom
      simp [hx] at hxdom
  · intro hx
    dsimp [dom, extensional_operator]
    simp [hx, N.eval_ne_bot ⟨x, hx⟩]

