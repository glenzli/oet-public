OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，无环网络作为有限网络）**
无环算子网络遗忘无环秩后给出有限算子网络；其输入域、深度界和
外延算子按定义保持。
-/
theorem acyclic_network_as_finite_summary :
    N.to_finite.U = N.U ∧
      N.to_finite.depth_bound = N.node_count ∧
        N.to_finite.extensional_operator = N.extensional_operator := by
  exact ⟨rfl, rfl, N.to_finite_extensional_operator_eq⟩

end OperatorNetwork

namespace FiniteOperatorNetwork

variable (N : FiniteOperatorNetwork X bot V)

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，路径相等）**
可达路径由其节点序列确定。
-/
theorem reachable_path_ext {p q : N.ReachablePath}
    (h : p.nodes = q.nodes) : p = q := by
  cases p with
  | mk pnodes pnonempty =>
      cases q with
      | mk qnodes qnonempty =>
          dsimp at h
          cases h
          rfl

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，路径域定义域）**
每条可达路径的路径域包含于对应路径链算子的定义域。
-/
theorem path_domain_subset_path_chain_dom (p : N.ReachablePath) :
    N.path_domain p.nodes ⊆ dom (N.path_chain p.nodes) := by
  intro x hx
  rcases hx with ⟨hxU, hpath⟩
  dsimp [dom]
  rw [N.path_chain_apply_eq_chain_eval_nodes]
  rw [← hpath]
  exact N.eval_ne_bot ⟨x, hxU⟩

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，前缀一步求值）**
路径前缀多执行一位，等于先执行较短前缀，再执行该位节点算子。
-/
theorem chain_eval_nodes_take_succ {nodes : List V} {n : Nat}
    (hn : n < nodes.length) (x : X) :
    N.chain_eval_nodes (nodes.take (n + 1)) x =
      (N.node_op (nodes.get ⟨n, hn⟩)).func
        (N.chain_eval_nodes (nodes.take n) x) := by
  induction nodes generalizing n x with
  | nil =>
      cases hn
  | cons β rest ih =>
      cases n with
      | zero =>
          simp [chain_eval_nodes, chain_eval_nodes_core]
      | succ n =>
          have hnrest : n < rest.length := by
            simpa using Nat.succ_lt_succ_iff.mp hn
          simpa [chain_eval_nodes, chain_eval_nodes_core] using
            ih hnrest ((N.node_op β).func x)

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，路径位置）**
无环展开的节点由一条可达终止路径和该路径中的一个位置组成。
-/
abbrev PathPosition : Type :=
  Σ p : N.ReachablePath, Fin p.nodes.length

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，位置投影）**
路径位置投影到原有限网络中的节点标签。
-/
def path_position_label (w : N.PathPosition) : V :=
  w.1.nodes.get w.2

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，标签序列投影）**
固定可达路径 `p` 时，沿所有路径位置读出的节点标签序列正好等于
原路径的节点标签序列。
-/
theorem path_position_label_sequence (p : N.ReachablePath) :
    (List.ofFn fun i : Fin p.nodes.length =>
      N.path_position_label (⟨p, i⟩ : N.PathPosition)) = p.nodes := by
  simp [path_position_label]

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，位置输入域）**
路径位置 `(p,s)` 的输入域是在路径域 `U_p` 上执行前 `s` 个节点之前
实际到达该位置的点集。
-/
def path_position_input_domain (w : N.PathPosition) : Set X :=
  N.chain_eval_nodes (w.1.nodes.take w.2.val) '' N.path_domain w.1.nodes

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，位置输入域非空）**
每个路径位置的输入域非空。
-/
theorem path_position_input_domain_nonempty (w : N.PathPosition) :
    (N.path_position_input_domain w).Nonempty := by
  rcases w.1.nonempty_domain with ⟨x, hx⟩
  exact ⟨N.chain_eval_nodes (w.1.nodes.take w.2.val) x,
    Set.mem_image_of_mem _ hx⟩

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，位置输入合法性）**
路径位置输入域包含于对应原节点的定义域。
-/
theorem path_position_input_domain_subset_node_dom (w : N.PathPosition) :
    N.path_position_input_domain w ⊆ dom (N.node_op (N.path_position_label w)) := by
  intro y hy
  rcases hy with ⟨x, hx, rfl⟩
  rcases hx with ⟨hxU, hpath⟩
  let xp : {x : X // x ∈ N.U} := ⟨x, hxU⟩
  let n : Fin (N.path_of xp).length :=
    ⟨w.2.val, by simp [xp, hpath, w.2.isLt]⟩
  have hmem :=
    terminal_path_prefix_input_mem N.choice_next_mem
      (N.entry_mem xp) (N.path_terminal xp) n
  simpa [PathPosition, path_position_label, path_position_input_domain,
    chain_eval_nodes, xp, hpath, n] using hmem

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，下一位置）**
路径位置的后继位置；末位置没有后继。
-/
noncomputable def path_position_next (w : N.PathPosition) : Option N.PathPosition :=
  if hnext : w.2.val + 1 < w.1.nodes.length then
    some ⟨w.1, ⟨w.2.val + 1, hnext⟩⟩
  else
    none

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，位置秩）**
路径位置到末端的剩余节点数给出无环秩。
-/
def path_position_rank (w : N.PathPosition) : Nat :=
  w.1.nodes.length - (w.2.val + 1)

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，位置局域算子）**
路径位置展开中的局域算子是原节点局域算子在该位置实际输入域上的限制。
-/
noncomputable def path_position_node_op (w : N.PathPosition) : Operator X bot :=
  restrict_operator (N.node_op (N.path_position_label w))
    (N.path_position_input_domain w)

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，位置算子定义域）**
路径位置局域算子的定义域正好是该位置输入域。
-/
theorem dom_path_position_node_op_eq (w : N.PathPosition) :
    dom (N.path_position_node_op w) = N.path_position_input_domain w := by
  exact
    dom_restrict_operator_eq
      (N.node_op (N.path_position_label w))
      (N.path_position_input_domain w)
      (N.path_position_input_domain_subset_node_dom w)

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，位置后继选择）**
展开网络的后继只沿同一终止路径的下一位置前进；末位置终止。
-/
noncomputable def path_position_choice (w : N.PathPosition) (_z : X) :
    OutputChoice N.PathPosition :=
  match N.path_position_next w with
  | some w' => OutputChoice.next w'
  | none => OutputChoice.stop

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，后继输入域）**
当前位置输入域经当前位置原节点算子后进入下一位置输入域。
-/
theorem path_position_node_output_mem_successor
    (w : N.PathPosition) (hnext : w.2.val + 1 < w.1.nodes.length)
    {y : X} (hy : y ∈ N.path_position_input_domain w) :
    (N.node_op (N.path_position_label w)).func y ∈
      N.path_position_input_domain
        ⟨w.1, ⟨w.2.val + 1, hnext⟩⟩ := by
  rcases hy with ⟨x, hx, rfl⟩
  refine ⟨x, hx, ?_⟩
  exact N.chain_eval_nodes_take_succ w.2.isLt x

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，后继秩下降）**
路径位置后继严格降低剩余长度秩。
-/
theorem path_position_successor_rank_lt
    (w : N.PathPosition) (hnext : w.2.val + 1 < w.1.nodes.length) :
    N.path_position_rank ⟨w.1, ⟨w.2.val + 1, hnext⟩⟩ <
      N.path_position_rank w := by
  dsimp [path_position_rank]
  omega

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，展开路径核）**
只由路径位置后继产生的有限路径。
-/
noncomputable def path_position_walk_with_fuel :
    Nat → N.PathPosition → List N.PathPosition
  | 0, w => [w]
  | n + 1, w =>
      w ::
        match N.path_position_next w with
        | some w' => path_position_walk_with_fuel n w'
        | none => []

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，路径核一致）**
展开网络的路径递归核与只由位置后继定义的路径核一致。
-/
theorem path_position_path_with_fuel_core_eq_walk :
    ∀ (n : Nat) (w : N.PathPosition) (y : X),
      path_with_fuel_core N.path_position_node_op
        N.path_position_choice n w y =
          N.path_position_walk_with_fuel n w := by
  intro n
  induction n with
  | zero =>
      intro w y
      simp [path_with_fuel_core, path_position_walk_with_fuel]
  | succ n ih =>
      intro w y
      unfold path_with_fuel_core path_position_walk_with_fuel
      cases hnext : N.path_position_next w with
      | none =>
          simp [path_position_choice, hnext]
      | some w' =>
          simp [path_position_choice, hnext, ih]

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，当前位置可达）**
任意燃料下，由某路径位置开始的展开路径都包含该起始位置。
-/
theorem path_position_self_mem_walk (n : Nat) (w : N.PathPosition) :
    w ∈ N.path_position_walk_with_fuel n w := by
  cases n with
  | zero =>
      simp [path_position_walk_with_fuel]
  | succ n =>
      simp [path_position_walk_with_fuel]

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，后续位置可达）**
从同一可达路径的第 `i` 位开始，展开路径包含所有后续第 `j` 位。
-/
theorem path_position_mem_walk_from_index (p : N.ReachablePath) :
    ∀ (i j : Nat) (hi : i < p.nodes.length) (hj : j < p.nodes.length),
      i ≤ j →
        (⟨p, ⟨j, hj⟩⟩ : N.PathPosition) ∈
          N.path_position_walk_with_fuel
            (p.nodes.length - (i + 1)) ⟨p, ⟨i, hi⟩⟩ := by
  intro i j hi hj hij
  induction hdiff : j - i using Nat.strong_induction_on generalizing i j with
  | h d ih =>
      by_cases heq : i = j
      · subst j
        exact N.path_position_self_mem_walk
          (p.nodes.length - (i + 1)) ⟨p, ⟨i, hi⟩⟩
      · have hlt : i < j := lt_of_le_of_ne hij heq
        have hnext : i + 1 < p.nodes.length := by omega
        have hfuel :
            p.nodes.length - (i + 1) =
              (p.nodes.length - ((i + 1) + 1)) + 1 := by
          omega
        rw [hfuel]
        have hnext_eq :
            N.path_position_next (⟨p, ⟨i, hi⟩⟩ : N.PathPosition) =
              some (⟨p, ⟨i + 1, hnext⟩⟩ : N.PathPosition) := by
          simp [path_position_next, hnext]
        rw [path_position_walk_with_fuel, hnext_eq, List.mem_cons]
        have hle_next : i + 1 ≤ j := by omega
        have hdiff_lt : j - (i + 1) < d := by omega
        exact Or.inr
          (ih (j - (i + 1)) hdiff_lt (i + 1) j hnext hj hle_next rfl)

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，逐位置构造）**
把每条终止路径逐位置复制为无分叉链，得到一个无环算子网络。
-/
noncomputable def path_position_acyclic_expansion :
    OperatorNetwork X bot N.PathPosition where
  U := N.U
  bot_not_mem := N.bot_not_mem
  node_fintype := by
    classical
    letI : Fintype N.ReachablePath := N.reachable_path_fintype
    infer_instance
  node_op := N.path_position_node_op
  node_dom_nonempty := by
    intro w
    rw [N.dom_path_position_node_op_eq w]
