theorem path_terminal (x : {x : X // x ∈ N.U}) :
    TerminalPathFrom N.node_op N.choice (N.entry x) x.val (N.path_of x) := by
  dsimp [path_of, path_from]
  exact N.path_with_fuel_terminal_of_rank_le
    (N.rank (N.entry x)) (N.entry x) x.val (N.entry_mem x) le_rfl

