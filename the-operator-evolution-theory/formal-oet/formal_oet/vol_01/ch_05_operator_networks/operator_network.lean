/--
OET anchor: h-86752cb60c8e01e3 **定义（边域包含输出像）** 边域包含于对应节点输出像。 -/
theorem edge_domain_subset_node_image (β γ : V) :
    N.edge_domain β γ ⊆ N.node_image β := by
  exact N.to_transition_graph.edge_domain_subset_node_image β γ

/--
OET anchor: h-86752cb60c8e01e3 **定义（边域进入后继定义域）** 边域包含于后继节点定义域。 -/
theorem edge_domain_subset_node_dom {β γ : V} :
    N.edge_domain β γ ⊆ N.node_dom γ := by
  simpa [edge_domain, node_dom, to_transition_graph] using
    N.to_transition_graph.edge_domain_subset_node_dom β γ

/--
OET anchor: h-86752cb60c8e01e3 **定义（有向无环性）** 非空边域对应的后继节点严格降低拓扑秩。 -/
theorem edge_domain_rank_lt {β γ : V}
    (h : (N.edge_domain β γ).Nonempty) :
    N.rank γ < N.rank β := by
  rcases h with ⟨z, hz⟩
  rcases hz.1 with ⟨y, hy, hyz⟩
  have hyN : y ∈ N.node_dom β := by
    simpa [node_dom] using hy
  have hchoice :
      N.choice β ((N.node_op β).func y) = OutputChoice.next γ := by
    simpa [hyz] using hz.2
  exact N.choice_next_rank hyN hchoice

/--
OET anchor: h-86752cb60c8e01e3 **定义（同源边域互斥）** 同一源节点的不同边域互不相交。 -/
theorem disjoint_edge_domain_of_ne {β γ γ' : V} (hne : γ ≠ γ') :
    Disjoint (N.edge_domain β γ) (N.edge_domain β γ') := by
  rw [Set.disjoint_iff]
  intro z hz
  have hnext :
      OutputChoice.next γ = OutputChoice.next γ' :=
    hz.1.2.symm.trans hz.2.2
  exact hne (OutputChoice.next.inj hnext)

/--
OET anchor: h-86752cb60c8e01e3
**定义（输出像的边域-终止分解）**
