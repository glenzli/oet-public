theorem mem_path_with_fuel_rank_le :
    ∀ (n : Nat) (β : V) (y : X) (δ : V),
      y ∈ N.node_dom β →
        δ ∈ N.path_with_fuel n β y →
          N.rank δ ≤ N.rank β := by
  intro n
  induction n with
  | zero =>
      intro β y δ _ hmem
      simp [path_with_fuel, path_with_fuel_core] at hmem
      simp [hmem]
  | succ n ih =>
      intro β y δ hy hmem
      unfold path_with_fuel path_with_fuel_core at hmem
      cases hchoice : N.choice β ((N.node_op β).func y) with
      | stop =>
          rw [hchoice] at hmem
          simp only [List.mem_singleton] at hmem
          simp [hmem]
      | next γ =>
          rw [hchoice] at hmem
          simp only [List.mem_cons] at hmem
          rcases hmem with rfl | hmem
          · exact le_rfl
          · have hyγ : (N.node_op β).func y ∈ N.node_dom γ :=
              N.choice_next_mem hy hchoice
            have hmem' : δ ∈ N.path_with_fuel n γ ((N.node_op β).func y) := by
              simpa [path_with_fuel] using hmem
            exact le_trans (ih γ ((N.node_op β).func y) δ hyγ hmem')
              (Nat.le_of_lt (N.choice_next_rank hy hchoice))

