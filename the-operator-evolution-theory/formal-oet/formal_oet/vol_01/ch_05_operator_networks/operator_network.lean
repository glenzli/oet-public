theorem to_finite_extensional_operator_eq :
    N.to_finite.extensional_operator = N.extensional_operator := by
  classical
  ext x
  by_cases hx : x ∈ N.U
  · simp [to_finite, FiniteOperatorNetwork.extensional_operator,
      FiniteOperatorNetwork.eval, extensional_operator, eval, eval_from,
      path_of, path_from, chain_eval_nodes, hx, N.eval_with_fuel_eq_chain_eval_nodes]
  · simp [to_finite, FiniteOperatorNetwork.extensional_operator,
