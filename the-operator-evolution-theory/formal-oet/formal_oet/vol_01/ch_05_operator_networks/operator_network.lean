theorem acyclic_expansion_exists :
  ∃ W : Type, ∃ dag : OperatorNetwork X bot W,
    ∃ node_projection : W → V,
      ∃ path_projection : dag.ReachablePath → N.ReachablePath,
        dag.U = N.U ∧
          dag.extensional_operator = N.extensional_operator ∧
            (∀ q : dag.ReachablePath,
              q.nodes.map node_projection = (path_projection q).nodes) ∧
              Function.Surjective path_projection := by
  exact N.acyclic_expansion_exists_of_witness N.acyclic_expansion_witness

