theorem eval_with_fuel_ne_bot :
    ∀ (n : Nat) (β : V) (y : X),
      y ∈ N.node_dom β → N.eval_with_fuel n β y ≠ bot := by
  intro n
  induction n with
  | zero =>
      intro β y hy
      exact hy
  | succ n ih =>
      intro β y hy
      unfold eval_with_fuel eval_with_fuel_core
      cases hchoice : N.choice β ((N.node_op β).func y) with
      | stop =>
          exact hy
      | next γ =>
          exact ih γ ((N.node_op β).func y)
            (N.choice_next_mem hy hchoice)

