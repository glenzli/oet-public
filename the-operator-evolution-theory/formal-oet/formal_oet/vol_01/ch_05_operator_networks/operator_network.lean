/--
OET anchor: h-86752cb60c8e01e3
**定义（无环算子网络）**
Lean keeps the transition-graph fields in the network structure and exposes
them as `to_transition_graph`.  The extra network data are the source domain,
the initial-entry partition, the acyclicity rank, and the nonredundancy
condition.  The choice map represents transition domains; actual edges are
nonempty derived transition domains.
`node_fintype` records the finiteness of the node set.
`rank` 是有向无环性的拓扑秩证书：每次进入后继节点都严格降低秩。
`node_reachable` 表示正文中纳入定义的无冗余节点约束。
-/
structure OperatorNetwork (X : Type) (bot : X) (V : Type) where
  U : Set X
  bot_not_mem : bot ∉ U
  node_fintype : Fintype V
  node_op : V → Operator X bot
  node_dom_nonempty : ∀ β : V, (dom (node_op β)).Nonempty
  entry : {x : X // x ∈ U} → V
  entry_mem : ∀ x : {x : X // x ∈ U}, x.val ∈ dom (node_op (entry x))
  choice : V → X → OutputChoice V
  choice_next_mem :
    ∀ {β γ : V} {y : X},
      y ∈ dom (node_op β) →
        choice β ((node_op β).func y) = OutputChoice.next γ →
          (node_op β).func y ∈ dom (node_op γ)
  rank : V → Nat
  choice_next_rank :
    ∀ {β γ : V} {y : X},
      y ∈ dom (node_op β) →
        choice β ((node_op β).func y) = OutputChoice.next γ →
          rank γ < rank β
  node_reachable :
    ∀ β : V, ∃ x : {x : X // x ∈ U},
      β ∈ path_with_fuel_core node_op choice (rank (entry x)) (entry x) x.val

namespace OperatorNetwork

variable (N : OperatorNetwork X bot V)

/--
OET anchor: h-86752cb60c8e01e3
**定义（算子网络的底层算子转移图）**
Forgetting the source-domain, entry, acyclicity and nonredundancy data leaves
the underlying operator transition graph.
-/
def to_transition_graph : OperatorTransitionGraph X bot V where
  node_fintype := N.node_fintype
  node_op := N.node_op
  node_dom_nonempty := N.node_dom_nonempty
  edge_domain := fun β γ =>
    {z | z ∈ (N.node_op β).func '' dom (N.node_op β) ∧
      N.choice β z = OutputChoice.next γ}
  edge_domain_subset_node_image := by
    intro β γ z hz
    exact hz.1
  edge_domain_subset_node_dom := by
    intro β γ z hz
    rcases hz.1 with ⟨y, hy, hyz⟩
    have hchoice :
        N.choice β ((N.node_op β).func y) = OutputChoice.next γ := by
      simpa [hyz] using hz.2
    have hmem : (N.node_op β).func y ∈ dom (N.node_op γ) :=
      N.choice_next_mem hy hchoice
    simpa [hyz] using hmem

@[simp]
theorem to_transition_graph_node_op :
    N.to_transition_graph.node_op = N.node_op :=
  rfl

