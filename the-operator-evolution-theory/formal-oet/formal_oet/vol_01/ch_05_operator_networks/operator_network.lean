theorem path_with_fuel_terminal_of_rank_le :
    ∀ (n : Nat) (β : V) (y : X),
      y ∈ N.node_dom β →
        N.rank β ≤ n →
          TerminalPathFrom N.node_op N.choice β y (N.path_with_fuel n β y) := by
  intro n
  induction n with
  | zero =>
      intro β y hy hrank
      unfold path_with_fuel path_with_fuel_core
      cases hchoice : N.choice β ((N.node_op β).func y) with
      | stop =>
          exact TerminalPathFrom.stop hchoice
      | next γ =>
          have hlt : N.rank γ < N.rank β := N.choice_next_rank hy hchoice
          have hzero : N.rank β = 0 := Nat.eq_zero_of_le_zero hrank
          rw [hzero] at hlt
          exact False.elim (Nat.not_lt_zero _ hlt)
  | succ n ih =>
      intro β y hy hrank
      unfold path_with_fuel path_with_fuel_core
      cases hchoice : N.choice β ((N.node_op β).func y) with
      | stop =>
          exact TerminalPathFrom.stop hchoice
      | next γ =>
          have hyγ : (N.node_op β).func y ∈ N.node_dom γ :=
            N.choice_next_mem hy hchoice
          have hγ_rank : N.rank γ ≤ n := by
            have hlt_succ : N.rank γ < n + 1 :=
              lt_of_lt_of_le (N.choice_next_rank hy hchoice) hrank
            exact Nat.le_of_lt_succ hlt_succ
          exact TerminalPathFrom.next hchoice (ih γ ((N.node_op β).func y) hyγ hγ_rank)

