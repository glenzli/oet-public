import formal_oet.vol_01.ch_04_operator_chain_calculus.decomposition_core
import Mathlib.Data.Fintype.Card
import Mathlib.Data.Fintype.Vector
import Mathlib.Tactic

namespace formal_oet.vol_01.ch_05_operator_networks

open formal_oet.vol_01.ch_01_foundations
open formal_oet.vol_01.ch_04_operator_chain_calculus

variable {X V : Type} {bot : X}

/--
OET anchor: h-86752cb60c8e01e3
**定义（输出选择）**
节点输出点或者终止，或者进入一个后继节点。
-/
inductive OutputChoice (V : Type) where
  | stop : OutputChoice V
  | next : V → OutputChoice V
deriving DecidableEq

/--
OET anchor: h-86752cb60c8e01e3
**定义（算子转移图）**
The transition-graph layer contains the finite node set, the local operator at
each node, and arbitrary transition domains. It is not assumed deterministic;
deterministic successor choice is added only at the finite-network layer.
-/
structure OperatorTransitionGraph (X : Type) (bot : X) (V : Type) where
  node_fintype : Fintype V
  node_op : V → Operator X bot
  node_dom_nonempty : ∀ β : V, (dom (node_op β)).Nonempty
  edge_domain : V → V → Set X
  edge_domain_subset_node_image :
    ∀ β γ : V, edge_domain β γ ⊆ (node_op β).func '' dom (node_op β)
  edge_domain_subset_node_dom :
    ∀ β γ : V, edge_domain β γ ⊆ dom (node_op γ)

namespace OperatorTransitionGraph

variable (T : OperatorTransitionGraph X bot V)

/--
OET anchor: h-86752cb60c8e01e3
**定义（节点定义域）**
At the transition-graph level, a node occurrence domain is exactly the domain
of its local operator.
-/
def node_dom (β : V) : Set X :=
  dom (T.node_op β)

/--
OET anchor: h-86752cb60c8e01e3
**定义（节点输出像）**
The output image of a node is the image of its local operator on the node
occurrence domain.
-/
def node_image (β : V) : Set X :=
  (T.node_op β).func '' T.node_dom β

/--
OET anchor: h-86752cb60c8e01e3
**定义（算子转移图的边）**
Lean treats an edge as a nonempty transition domain, matching the text's
nonempty-edge convention.
-/
def Edge (β γ : V) : Prop :=
  (T.edge_domain β γ).Nonempty

/--
OET anchor: h-86752cb60c8e01e3
**定义（终止域）**
The terminal domain is the part of the node output image that enters no
successor transition domain.
-/
def terminal_domain (β : V) : Set X :=
  T.node_image β \ ⋃ γ : V, T.edge_domain β γ

/--
OET anchor: h-86752cb60c8e01e3
**定义（带节点标签的一步转移）**
The transition relation records both the source node and the target node; point
value alone does not determine the computation state.
-/
def Step (β γ : V) (x y : X) : Prop :=
  x ∈ T.node_dom β ∧ y = (T.node_op β).func x ∧ y ∈ T.edge_domain β γ

theorem node_image_mem_terminal_or_edge {β : V} {z : X}
    (hz : z ∈ T.node_image β) :
    z ∈ T.terminal_domain β ∨ ∃ γ : V, z ∈ T.edge_domain β γ := by
  classical
  by_cases h : ∃ γ : V, z ∈ T.edge_domain β γ
  · exact Or.inr h
  · left
    refine ⟨hz, ?_⟩
    intro hmem
    rcases Set.mem_iUnion.mp hmem with ⟨γ, hγ⟩
    exact h ⟨γ, hγ⟩

theorem terminal_domain_subset_node_image (β : V) :
    T.terminal_domain β ⊆ T.node_image β := by
  intro z hz
  exact hz.1

theorem step_output_eq {β γ : V} {x y : X} (h : T.Step β γ x y) :
    y = (T.node_op β).func x :=
  h.2.1

end OperatorTransitionGraph

/--
OET anchor: h-86752cb60c8e01e3
**§ #h-86752cb60c8e01e3（有限求值的递归核）**
该核只依赖节点算子与输出选择，因而可在 `OperatorNetwork` 结构字段中
表达无冗余节点条件。
-/
def eval_with_fuel_core (node_op : V → Operator X bot)
    (choice : V → X → OutputChoice V) : Nat → V → X → X
  | 0, β, y => (node_op β).func y
  | n + 1, β, y =>
      match choice β ((node_op β).func y) with
      | OutputChoice.stop => (node_op β).func y
      | OutputChoice.next γ =>
          eval_with_fuel_core node_op choice n γ ((node_op β).func y)

/--
OET anchor: h-86752cb60c8e01e3
**§ #h-86752cb60c8e01e3（路径节点序列的递归核）**
与 `eval_with_fuel_core` 同步记录实际经过的节点序列。
-/
def path_with_fuel_core (node_op : V → Operator X bot)
    (choice : V → X → OutputChoice V) : Nat → V → X → List V
  | 0, β, _ => [β]
  | n + 1, β, y =>
      β ::
        match choice β ((node_op β).func y) with
        | OutputChoice.stop => []
        | OutputChoice.next γ =>
            path_with_fuel_core node_op choice n γ ((node_op β).func y)

/--
OET anchor: h-86752cb60c8e01e3
**定义（终止求值轨迹）**
The node list is exactly the trajectory generated by the deterministic choice
map and it stops at the last node.
-/
inductive TerminalPathFrom (node_op : V → Operator X bot)
    (choice : V → X → OutputChoice V) : V → X → List V → Prop where
  | stop {β : V} {y : X} :
      choice β ((node_op β).func y) = OutputChoice.stop →
        TerminalPathFrom node_op choice β y [β]
  | next {β γ : V} {y : X} {rest : List V} :
      choice β ((node_op β).func y) = OutputChoice.next γ →
        TerminalPathFrom node_op choice γ ((node_op β).func y) rest →
          TerminalPathFrom node_op choice β y (β :: rest)

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（路径链求值）**
按节点序列从左到右执行局域算子。
-/
def chain_eval_nodes_core (node_op : V → Operator X bot) : List V → X → X
  | [], x => x
  | β :: rest, x => chain_eval_nodes_core node_op rest ((node_op β).func x)

/--
OET anchor: h-86752cb60c8e01e3
**定义（有限算子网络）**
This is the finite-network layer used by the object space.  It records a
finite node family, an entry rule, a single-valued transition choice, and a
uniformly bounded terminal path for each source input.
-/
structure FiniteOperatorNetwork (X : Type) (bot : X) (V : Type) where
  U : Set X
  bot_not_mem : bot ∉ U
  node_fintype : Fintype V
  node_op : V → Operator X bot
  node_dom_nonempty : ∀ β : V, (dom (node_op β)).Nonempty
  entry : {x : X // x ∈ U} → V
  entry_mem : ∀ x : {x : X // x ∈ U}, x.val ∈ dom (node_op (entry x))
  choice : V → X → OutputChoice V
  choice_next_mem :
    ∀ {β γ : V} {y : X},
      y ∈ dom (node_op β) →
        choice β ((node_op β).func y) = OutputChoice.next γ →
          (node_op β).func y ∈ dom (node_op γ)
  depth_bound : Nat
  path_of : {x : X // x ∈ U} → List V
  path_terminal :
    ∀ x : {x : X // x ∈ U},
      TerminalPathFrom node_op choice (entry x) x.val (path_of x)
  path_length_le_depth :
    ∀ x : {x : X // x ∈ U}, (path_of x).length ≤ depth_bound
  node_reachable :
    ∀ β : V, ∃ x : {x : X // x ∈ U}, β ∈ path_of x

namespace FiniteOperatorNetwork

variable (N : FiniteOperatorNetwork X bot V)

/-- The number of nodes in a concrete finite network, used to compare
network representations independently of their extensional operators. -/
def node_count : Nat :=
  @Fintype.card V N.node_fintype

/--
OET anchor: h-86752cb60c8e01e3
**定义（有限算子网络的底层算子转移图）**
Forgetting the source-domain, entry, path and nonredundancy data leaves the
underlying operator transition graph.
-/
def to_transition_graph : OperatorTransitionGraph X bot V where
  node_fintype := N.node_fintype
  node_op := N.node_op
  node_dom_nonempty := N.node_dom_nonempty
  edge_domain := fun β γ =>
    {z | z ∈ (N.node_op β).func '' dom (N.node_op β) ∧
      N.choice β z = OutputChoice.next γ}
  edge_domain_subset_node_image := by
    intro β γ z hz
    exact hz.1
  edge_domain_subset_node_dom := by
    intro β γ z hz
    rcases hz.1 with ⟨y, hy, hyz⟩
    have hchoice :
        N.choice β ((N.node_op β).func y) = OutputChoice.next γ := by
      simpa [hyz] using hz.2
    have hmem : (N.node_op β).func y ∈ dom (N.node_op γ) :=
      N.choice_next_mem hy hchoice
    simpa [hyz] using hmem

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（路径链求值）**
The finite network evaluates by the path assigned to the input.
-/
def eval (x : {x : X // x ∈ N.U}) : X :=
  chain_eval_nodes_core N.node_op (N.path_of x) x.val

theorem terminal_path_nonempty {node_op : V → Operator X bot}
    {choice : V → X → OutputChoice V} {β : V} {y : X} {p : List V}
    (h : TerminalPathFrom node_op choice β y p) : p.length ≠ 0 := by
  cases h <;> simp

theorem terminal_path_eval_ne_bot {node_op : V → Operator X bot}
    {choice : V → X → OutputChoice V}
    (choice_next_mem :
      ∀ {β γ : V} {y : X},
        y ∈ dom (node_op β) →
          choice β ((node_op β).func y) = OutputChoice.next γ →
            (node_op β).func y ∈ dom (node_op γ)) :
    ∀ {β : V} {y : X} {p : List V},
      y ∈ dom (node_op β) →
        TerminalPathFrom node_op choice β y p →
          chain_eval_nodes_core node_op p y ≠ bot := by
  intro β y p hy hpath
  induction hpath with
  | stop hstop =>
      simpa [chain_eval_nodes_core] using hy
  | next hnext hrest ih =>
      have hy_next :=
        choice_next_mem hy hnext
      simpa [chain_eval_nodes_core] using ih hy_next

/--
OET anchor: h-3d5365e74a8359df
**命题 #h-3d5365e74a8359df（有限网络的无环展开，前缀输入合法性）**
终止路径上第 `n` 个节点的实际输入属于该节点局域算子的定义域。
-/
theorem terminal_path_prefix_input_mem {node_op : V → Operator X bot}
    {choice : V → X → OutputChoice V}
    (choice_next_mem :
      ∀ {β γ : V} {y : X},
        y ∈ dom (node_op β) →
          choice β ((node_op β).func y) = OutputChoice.next γ →
            (node_op β).func y ∈ dom (node_op γ)) :
    ∀ {β : V} {y : X} {p : List V},
      y ∈ dom (node_op β) →
        TerminalPathFrom node_op choice β y p →
          ∀ n : Fin p.length,
            chain_eval_nodes_core node_op (p.take n.val) y ∈
              dom (node_op (p.get n)) := by
  intro β y p hy hpath
  induction hpath with
  | stop hstop =>
      intro n
      fin_cases n
      simpa [chain_eval_nodes_core] using hy
  | next hnext hrest ih =>
      rename_i β0 γ0 y0 rest
      intro n
      cases n with
      | mk k hk =>
          cases k with
          | zero =>
              simpa [chain_eval_nodes_core] using hy
          | succ k =>
              have hkrest : k < rest.length := by
                simpa using Nat.succ_lt_succ_iff.mp hk
              have hy_next : (node_op β0).func y0 ∈ dom (node_op γ0) :=
                choice_next_mem hy hnext
              have hmem := ih hy_next ⟨k, hkrest⟩
              simpa [chain_eval_nodes_core] using hmem

/--
OET anchor: h-86752cb60c8e01e3
**定义（终止求值轨迹非空）**
Every stored finite-network path is a nonempty terminal trajectory.
-/
theorem path_nonempty (x : {x : X // x ∈ N.U}) :
    (N.path_of x).length ≠ 0 :=
  terminal_path_nonempty (N.path_terminal x)

/--
OET anchor: h-86752cb60c8e01e3
**定义（有限求值不落入吸收元）**
The terminal trajectory generated by the network never evaluates to `bot` on
the source domain.
-/
theorem eval_ne_bot (x : {x : X // x ∈ N.U}) : N.eval x ≠ bot :=
  terminal_path_eval_ne_bot N.choice_next_mem (N.entry_mem x) (N.path_terminal x)

/--
OET anchor: h-86752cb60c8e01e3
**定义（外延算子）**
The finite network's source-domain evaluation, extended by `bot` outside `U`.
-/
noncomputable def extensional_operator : Operator X bot :=
  by
    classical
    refine
      ⟨fun x => if hx : x ∈ N.U then N.eval ⟨x, hx⟩ else bot, ?_⟩
    simp [N.bot_not_mem]

/--
OET anchor: h-86752cb60c8e01e3
**定义（外延算子定义域）**
The extensional operator of a finite network has domain exactly `U`.
-/
theorem dom_extensional_operator_eq : dom N.extensional_operator = N.U := by
  classical
  ext x
  constructor
  · intro hxdom
    by_cases hx : x ∈ N.U
    · exact hx
    · dsimp [dom, extensional_operator] at hxdom
      simp [hx] at hxdom
  · intro hx
    dsimp [dom, extensional_operator]
    simpa [hx] using N.eval_ne_bot ⟨x, hx⟩

/--
OET anchor: h-86752cb60c8e01e3
**定义（入口输入片）**
The entry function induces the source-domain block assigned to each node.
-/
def entry_domain (β : V) : Set X :=
  {x | ∃ hx : x ∈ N.U, N.entry ⟨x, hx⟩ = β}

/--
OET anchor: h-86752cb60c8e01e3
**定义（节点定义域）**
节点定义域是该节点局域算子的定义域。
-/
def node_dom (β : V) : Set X :=
  N.to_transition_graph.node_dom β

/--
OET anchor: h-86752cb60c8e01e3
**定义（节点定义域）**
派生记号 `node_dom` 与局域算子定义域相等。
-/
theorem node_dom_eq_dom (β : V) : N.node_dom β = dom (N.node_op β) :=
  rfl

/--
OET anchor: h-86752cb60c8e01e3
**定义（节点输出像）**
节点局域算子在节点定义域上的像。
-/
def node_image (β : V) : Set X :=
  N.to_transition_graph.node_image β

/--
OET anchor: h-86752cb60c8e01e3
**定义（边域）**
有限网络的边域由输出像上的确定后继选择给出。
-/
def edge_domain (β γ : V) : Set X :=
  N.to_transition_graph.edge_domain β γ

/--
OET anchor: h-86752cb60c8e01e3
**定义（终止域）**
终止域是节点输出像中没有进入任何后继边域的部分。
-/
def terminal_domain (β : V) : Set X :=
  N.to_transition_graph.terminal_domain β

/--
OET anchor: h-86752cb60c8e01e3
**定义（边域包含输出像）**
边域包含于对应节点输出像。
-/
theorem edge_domain_subset_node_image (β γ : V) :
    N.edge_domain β γ ⊆ N.node_image β := by
  exact N.to_transition_graph.edge_domain_subset_node_image β γ

/--
OET anchor: h-86752cb60c8e01e3
**定义（边域进入后继定义域）**
边域包含于后继节点定义域。
-/
theorem edge_domain_subset_node_dom {β γ : V} :
    N.edge_domain β γ ⊆ N.node_dom γ := by
  simpa [edge_domain, node_dom, to_transition_graph] using
    N.to_transition_graph.edge_domain_subset_node_dom β γ

/--
OET anchor: h-86752cb60c8e01e3
**定义（同源边域互斥）**
有限算子网络中的确定后继选择使同一源节点的不同边域互不相交。
-/
theorem disjoint_edge_domain_of_ne {β γ γ' : V} (hne : γ ≠ γ') :
    Disjoint (N.edge_domain β γ) (N.edge_domain β γ') := by
  rw [Set.disjoint_iff]
  intro z hz
  have hnext :
      OutputChoice.next γ = OutputChoice.next γ' :=
    hz.1.2.symm.trans hz.2.2
  exact hne (OutputChoice.next.inj hnext)

/--
OET anchor: h-86752cb60c8e01e3
**定义（输出像的边域-终止分解）**
节点输出像中的点要么属于终止域，要么属于某个后继边域。
-/
theorem node_image_mem_terminal_or_edge {β : V} {z : X}
    (hz : z ∈ N.node_image β) :
    z ∈ N.terminal_domain β ∨ ∃ γ : V, z ∈ N.edge_domain β γ := by
  cases hchoice : N.choice β z with
  | stop =>
      left
      refine ⟨hz, ?_⟩
      intro hmem
      rcases Set.mem_iUnion.mp hmem with ⟨γ, hγ⟩
      have hcontr :
          OutputChoice.stop = OutputChoice.next γ :=
        hchoice.symm.trans hγ.2
      cases hcontr
  | next γ =>
      right
      exact ⟨γ, hz, hchoice⟩

/--
OET anchor: h-86752cb60c8e01e3
**定义（终止域包含输出像）**
终止域包含于对应节点输出像。
-/
theorem terminal_domain_subset_node_image (β : V) :
    N.terminal_domain β ⊆ N.node_image β := by
  intro z hz
  exact hz.1

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（路径链求值）**
按节点序列从左到右执行局域算子。
-/
def chain_eval_nodes (nodes : List V) (x : X) : X :=
  chain_eval_nodes_core N.node_op nodes x

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（路径链求值）**
节点序列拼接的求值等于先求值左段，再从所得点求值右段。
-/
theorem chain_eval_nodes_append (left right : List V) (x : X) :
    N.chain_eval_nodes (left ++ right) x =
      N.chain_eval_nodes right (N.chain_eval_nodes left x) := by
  induction left generalizing x with
  | nil => rfl
  | cons beta rest ih =>
      simp only [List.cons_append, chain_eval_nodes, chain_eval_nodes_core]
      exact ih ((N.node_op beta).func x)

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（路径链算子）**
节点序列对应的复合算子。
-/
def path_chain (nodes : List V) : Operator X bot :=
  OperatorChain ((nodes.map N.node_op).reverse)

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（链复合辅助）**
`OperatorChain` 对列表拼接的求值公式。
-/
theorem operator_chain_append_apply (ops₁ ops₂ : List (Operator X bot)) (x : X) :
    (OperatorChain (ops₁ ++ ops₂)).func x =
      (OperatorChain ops₁).func ((OperatorChain ops₂).func x) := by
  induction ops₁ with
  | nil =>
      simp [OperatorChain]
  | cons op tail ih =>
      simp [OperatorChain, ih]

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（路径链求值）**
`path_chain` 与节点序列逐步求值一致。
-/
theorem path_chain_apply_eq_chain_eval_nodes (nodes : List V) (x : X) :
    (N.path_chain nodes).func x = N.chain_eval_nodes nodes x := by
  induction nodes generalizing x with
  | nil =>
      simp [path_chain, chain_eval_nodes, chain_eval_nodes_core, OperatorChain]
  | cons β rest ih =>
      rw [path_chain, List.map_cons, List.reverse_cons]
      rw [operator_chain_append_apply]
      change
        (N.path_chain rest).func ((N.node_op β).func x) =
          N.chain_eval_nodes rest ((N.node_op β).func x)
      exact ih ((N.node_op β).func x)

/--
OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，逐点形式）**
有限网络外延算子在 `x` 上等于其网络路径对应的复合求值。
-/
theorem extensional_apply_eq_chain_eval_path (x : {x : X // x ∈ N.U}) :
    N.extensional_operator.func x.val = N.chain_eval_nodes (N.path_of x) x.val := by
  classical
  dsimp [extensional_operator, eval, chain_eval_nodes]
  simp [x.property]

/--
OET anchor: h-374f884cd4d69e88
**定义（路径域）**
路径 `p` 的输入域。
-/
def path_domain (p : List V) : Set X :=
  {x | ∃ hx : x ∈ N.U, N.path_of ⟨x, hx⟩ = p}

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（可达路径）**
路径域非空的节点序列。
-/
structure ReachablePath where
  nodes : List V
  nonempty_domain : (N.path_domain nodes).Nonempty

/--
OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，局部等价）**
有限网络在每条可达路径域上满足路径链局部等价。
-/
theorem local_equivalent_extensional_path_chain (p : N.ReachablePath) :
    LocalEquivalent N.extensional_operator (N.path_chain p.nodes)
      (N.path_domain p.nodes) := by
  intro x hx
  rcases hx with ⟨hxU, hpath⟩
  calc
    N.extensional_operator.func x =
        N.chain_eval_nodes (N.path_of ⟨x, hxU⟩) x :=
      N.extensional_apply_eq_chain_eval_path ⟨x, hxU⟩
    _ = N.chain_eval_nodes p.nodes x := by rw [hpath]
    _ = (N.path_chain p.nodes).func x :=
      (N.path_chain_apply_eq_chain_eval_nodes p.nodes x).symm

/--
OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，路径长度界）**
每条可达路径的节点数不超过网络给定的统一深度界。
-/
theorem reachable_path_nodes_length_le_depth (p : N.ReachablePath) :
    p.nodes.length ≤ N.depth_bound := by
  rcases p.nonempty_domain with ⟨x, hxU, hpath⟩
  rw [← hpath]
  exact N.path_length_le_depth ⟨x, hxU⟩

/--
OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，编码）**
可达路径可注入到长度不超过深度界的有限向量族中。
-/
noncomputable def reachable_path_code (p : N.ReachablePath) :
    Fin (N.depth_bound + 1) × (Fin N.depth_bound → Option V) :=
  (⟨p.nodes.length,
      Nat.lt_succ_of_le (N.reachable_path_nodes_length_le_depth p)⟩,
    fun i =>
      if hi : i.val < p.nodes.length then
        some (p.nodes.get ⟨i.val, hi⟩)
      else
        none)

/--
OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，有限性）**
可达路径编码是单射。
-/
theorem reachable_path_code_injective :
    Function.Injective N.reachable_path_code := by
  intro p q hpq
  cases p with
  | mk pnodes pnonempty =>
      cases q with
      | mk qnodes qnonempty =>
          have hp_len :
              pnodes.length ≤ N.depth_bound :=
            N.reachable_path_nodes_length_le_depth
              ⟨pnodes, pnonempty⟩
          have hq_len :
              qnodes.length ≤ N.depth_bound :=
            N.reachable_path_nodes_length_le_depth
              ⟨qnodes, qnonempty⟩
          have hlen : pnodes.length = qnodes.length := by
            exact Fin.ext_iff.mp (congrArg Prod.fst hpq)
          have hget :
              ∀ (n : Nat) (hp : n < pnodes.length) (hq : n < qnodes.length),
                pnodes.get ⟨n, hp⟩ = qnodes.get ⟨n, hq⟩ := by
            intro n hp hq
            have hn : n < N.depth_bound := lt_of_lt_of_le hp hp_len
            have hfun :=
              congrFun (congrArg Prod.snd hpq) ⟨n, hn⟩
            dsimp [reachable_path_code] at hfun
            simp only [hp, hq, ↓reduceDIte] at hfun
            exact Option.some.inj hfun
          have hnodes : pnodes = qnodes := by
            exact List.ext_get hlen hget
          cases hnodes
          rfl

/--
OET anchor: h-56edb9917107efcd
The bounded sequence encoding supplies the finite reachable-path type used
by path counting and by the acyclic expansion.
-/
noncomputable instance reachable_path_fintype : Fintype N.ReachablePath := by
  letI : Fintype V := N.node_fintype
  exact Fintype.ofInjective N.reachable_path_code
    N.reachable_path_code_injective

/--
OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，求值深度）**
The evaluation depth, written `\operatorname{Depth}(\mathcal N)` in the text,
is the maximum length of an actually reachable path.
The stored `depth_bound` is used only to establish finiteness of the path
family.
-/
noncomputable def evaluation_depth : Nat := by
  letI : Fintype N.ReachablePath := N.reachable_path_fintype
  exact Finset.univ.sup fun p : N.ReachablePath => p.nodes.length

/--
OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，求值深度界）**
Every reachable path has length bounded by the actual evaluation depth.
-/
theorem reachable_path_nodes_length_le_evaluation_depth (p : N.ReachablePath) :
    p.nodes.length ≤ N.evaluation_depth := by
  classical
  letI : Fintype N.ReachablePath := N.reachable_path_fintype
  exact Finset.le_sup (s := Finset.univ)
    (f := fun q : N.ReachablePath => q.nodes.length) (Finset.mem_univ p)

/-- Every reachable terminal path contains at least its entry node. -/
theorem reachable_path_nodes_nonempty (p : N.ReachablePath) : p.nodes ≠ [] := by
  rcases p.nonempty_domain with ⟨x, hxU, hpath⟩
  rw [← hpath]
  intro hempty
  apply N.path_nonempty ⟨x, hxU⟩
  simp [hempty]

/--
The finite type of positive lengths bounded by the evaluation depth.
-/
abbrev ReachablePathLength : Type :=
  {r : Nat // r ∈ Finset.Icc 1 N.evaluation_depth}

/-- The exact code space for bounded nonempty node sequences. -/
abbrev ReachablePathSharpCode : Type :=
  Σ r : N.ReachablePathLength, Fin r.val → V

/-- A sharp code retains the exact path length and every node label. -/
noncomputable def reachable_path_sharp_code (p : N.ReachablePath) :
    N.ReachablePathSharpCode := by
  have hpos : 0 < p.nodes.length :=
    Nat.pos_of_ne_zero <| by
      intro hzero
      apply N.reachable_path_nodes_nonempty p
      exact List.length_eq_zero_iff.mp hzero
  have hle := N.reachable_path_nodes_length_le_evaluation_depth p
  let r : N.ReachablePathLength :=
    ⟨p.nodes.length, Finset.mem_Icc.mpr ⟨hpos, hle⟩⟩
  exact ⟨r, fun i => p.nodes.get ⟨i.val, i.isLt⟩⟩

/-- Decode a sharp path code to its node sequence. -/
def reachable_path_sharp_code_nodes (c : N.ReachablePathSharpCode) : List V :=
  List.ofFn c.2

/-- Encoding followed by decoding recovers the original node sequence. -/
theorem reachable_path_sharp_code_nodes_encode (p : N.ReachablePath) :
    N.reachable_path_sharp_code_nodes (N.reachable_path_sharp_code p) =
      p.nodes := by
  simp [reachable_path_sharp_code_nodes, reachable_path_sharp_code]

/-- The sharp reachable-path code is injective. -/
theorem reachable_path_sharp_code_injective :
    Function.Injective N.reachable_path_sharp_code := by
  intro p q hpq
  have hnodes : p.nodes = q.nodes := by
    calc
      p.nodes =
          N.reachable_path_sharp_code_nodes (N.reachable_path_sharp_code p) :=
        (N.reachable_path_sharp_code_nodes_encode p).symm
      _ = N.reachable_path_sharp_code_nodes (N.reachable_path_sharp_code q) := by
        rw [hpq]
      _ = q.nodes := N.reachable_path_sharp_code_nodes_encode q
  cases p with
  | mk pnodes pnonempty =>
      cases q with
      | mk qnodes qnonempty =>
          dsimp at hnodes
          cases hnodes
          rfl

/--
OET anchor: h-56edb9917107efcd
**命题 #h-56edb9917107efcd（路径分解与可达路径有限性，精确计数上界）**
The number of reachable paths is bounded by the number of all nonempty node
sequences of length at most the actual evaluation depth.
-/
theorem reachable_path_card_le_sum_powers :
    letI : Fintype V := N.node_fintype
    Fintype.card N.ReachablePath ≤
      ∑ r ∈ Finset.Icc 1 N.evaluation_depth, (Fintype.card V) ^ r := by
  classical
  letI : Fintype V := N.node_fintype
  letI : Fintype N.ReachablePath := N.reachable_path_fintype
  calc
    Fintype.card N.ReachablePath ≤ Fintype.card N.ReachablePathSharpCode :=
      Fintype.card_le_of_injective N.reachable_path_sharp_code
        N.reachable_path_sharp_code_injective
    _ = ∑ r : N.ReachablePathLength,
        (Fintype.card V) ^ r.val := by
      simp [ReachablePathSharpCode]
    _ = ∑ r ∈ Finset.Icc 1 N.evaluation_depth,
        (Fintype.card V) ^ r := by
      change
        (∑ r ∈ (Finset.Icc 1 N.evaluation_depth).attach,
          (Fintype.card V) ^ r.val) = _
      exact Finset.sum_attach (Finset.Icc 1 N.evaluation_depth)
        (fun r => (Fintype.card V) ^ r)

/--
OET anchor: h-374f884cd4d69e88
**§ #h-374f884cd4d69e88（路径域）**
每个路径域都包含于 `U`。
