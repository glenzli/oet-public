theorem path_with_fuel_length_le :
    ∀ (n : Nat) (β : V) (y : X),
      (N.path_with_fuel n β y).length ≤ n + 1 := by
  intro n
  induction n with
  | zero =>
      intro β y
      simp [path_with_fuel, path_with_fuel_core]
  | succ n ih =>
      intro β y
      unfold path_with_fuel path_with_fuel_core
      cases N.choice β ((N.node_op β).func y) with
      | stop =>
          simp
      | next γ =>
          simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
            using Nat.succ_le_succ (ih γ ((N.node_op β).func y))

/--
OET anchor: h-13bcaf7893e917fe **引理 #h-13bcaf7893e917fe（无环网络的深度界，有限求值）** 每条路径长度不超过入口节点秩加一。 -/
theorem path_of_length_le_rank_succ (x : {x : X // x ∈ N.U}) :
    (N.path_of x).length ≤ N.rank (N.entry x) + 1 := by
  dsimp [path_of, path_from]
  exact N.path_with_fuel_length_le (N.rank (N.entry x)) (N.entry x) x.val

/--
OET anchor: h-13bcaf7893e917fe
**引理 #h-13bcaf7893e917fe（秩下降）**
任意燃料路径中的节点秩不超过起点节点秩。
