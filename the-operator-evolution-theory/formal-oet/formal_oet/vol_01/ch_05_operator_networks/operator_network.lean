每条可达路径的节点数不超过 `|V|`。
-/
theorem reachable_path_nodes_length_le_node_count (p : N.ReachablePath) :
    p.nodes.length ≤ N.node_count := by
  rcases p.nonempty_domain with ⟨x, hxU, hpath⟩
  rw [← hpath]
  exact N.path_of_length_le_node_count ⟨x, hxU⟩

